# --- Anthropic (default) ---------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- or an Anthropic-compatible endpoint, e.g. z.ai / GLM ------------------
# The wire format is the same; the newer first-party fields (adaptive thinking,
# output_config.effort, cache_control) are dropped automatically in this profile.
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_AUTH_TOKEN=your-z-ai-key
# AGENT_API_PROFILE=compatible
# AGENT_MODEL=glm-4.6
# AGENT_SMALL_MODEL=glm-4.6

# --- behaviour -------------------------------------------------------------
# AGENT_MODEL=claude-opus-5
# AGENT_SMALL_MODEL=claude-haiku-4-5
# AGENT_EFFORT=high
# AGENT_SAFETY=ask          # ask | strict | yolo
# AGENT_CONTEXT_BUDGET=70000
# AGENT_MAX_STEPS=60
# AGENT_PROFILE_DIR=./profiles/default

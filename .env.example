# ---------------------------------------------------------------- Anthropic --
# Default provider. Uses the full Messages API surface: adaptive thinking,
# output_config.effort, prompt caching.
ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-opus-5
# AGENT_SMALL_MODEL=claude-haiku-4-5
# AGENT_EFFORT=high            # low | medium | high | xhigh | max

# ------------------------------------------ Anthropic-compatible endpoint ----
# e.g. z.ai's GLM coding plan (https://docs.z.ai/devpack/tool/claude).
# Same wire format; the newer first-party fields are dropped automatically in
# this profile, and count_tokens falls back to a calibrated local estimate if
# the endpoint does not implement it.
#
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_AUTH_TOKEN=your_zai_api_key
# AGENT_API_PROFILE=compatible
# AGENT_MODEL=glm-4.6          # or glm-5.3
# AGENT_SMALL_MODEL=glm-4.6    # or glm-5.3-flash

# ---------------------------------------------------------------- behaviour --
# AGENT_SAFETY=ask             # ask | strict | yolo
# AGENT_LLM_JUDGE=1            # 0 disables the small-model risk judge
# AGENT_CONTEXT_BUDGET=70000
# AGENT_MAX_STEPS=60
# AGENT_PROFILE_DIR=./profiles/default
